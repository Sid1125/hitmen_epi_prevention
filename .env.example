# Discord bot credentials
DISCORD_TOKEN=your_discord_bot_token_here
TARGET_CHANNEL_ID=your_discord_channel_id_here

# Backend API base URL (for frontend fetch calls)
# Local dev: (empty, uses same origin)
# HF Space: https://username-space-name.hf.space
VITE_API_BASE_URL=

# React Router basename (for subpath deployment)
# GitHub Pages username.github.io/repo-name -> /repo-name
# Custom domain: (empty)
VITE_BASE_URL=

# Database (for forum backend)
# Local Docker: postgresql://forum:secret@db:5432/forumdb
# HF Space: use Neon or Supabase free tier
DATABASE_URL=postgresql://forum:secret@db:5432/forumdb

# Hugging Face Space token (for CI auto-deploy)
HF_TOKEN=
